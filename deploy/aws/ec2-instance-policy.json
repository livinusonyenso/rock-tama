{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    {
      "Sid": "EcrPullRocktamaOnly",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": "arn:aws:ecr:eu-north-1:638486126885:repository/rocktama/*"
    },
    {
      "Sid": "ReadStagingSecretsOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-north-1:638486126885:parameter/rocktama/staging/bootstrap-password",
        "arn:aws:ssm:eu-north-1:638486126885:parameter/rocktama/staging/migrator-password",
        "arn:aws:ssm:eu-north-1:638486126885:parameter/rocktama/staging/api-password"
      ]
    },
    {
      "Sid": "DecryptThroughSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.eu-north-1.amazonaws.com" } }
    }
  ]
}
