{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublishReleaseImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:eu-north-1:638486126885:repository/rocktama/api",
        "arn:aws:ecr:eu-north-1:638486126885:repository/rocktama/web",
        "arn:aws:ecr:eu-north-1:638486126885:repository/rocktama/db-bootstrap",
        "arn:aws:ecr:eu-north-1:638486126885:repository/rocktama/edge"
      ]
    },
    {
      "Sid": "RunCommandOnStagingHost",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:eu-north-1::document/AWS-RunShellScript",
        "arn:aws:ec2:eu-north-1:638486126885:instance/i-0ad28bbea578fa416"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-north-1" } }
    }
  ]
}
