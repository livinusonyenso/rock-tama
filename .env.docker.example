# Template for .env.docker (local Docker Compose only). Copy to .env.docker and fill in values.
# .env.docker is git-ignored; never commit real values. Generate passwords with: openssl rand -hex 24
# (hex avoids characters that would need escaping inside a postgresql:// URL).

# Bootstrap superuser: created by the postgres image on a NEW volume. Used only by db-bootstrap.
POSTGRES_USER=rocktama_app
POSTGRES_DB=rocktama
POSTGRES_PASSWORD=

# Migration role (owns tables, runs backend/migrations). Used only by the migrate service.
MIGRATOR_PASSWORD=

# Runtime role (application data, no schema or account approval changes). Used by the API.
API_DB_PASSWORD=

# Optional local override: comma-separated exact origins (no path or trailing slash), all HTTPS or all HTTP loopback.
# The default allows next dev (:3000), the visual harness (:3100) and direct API checks (:4000).
# AUTH_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3100,http://127.0.0.1:4000

# Optional. Comma-separated addresses or CIDRs of the reverse proxy allowed to set X-Forwarded-For
# (for example the Next.js container's subnet or the VPC range of an ALB). Leave empty locally.
# "true", "*", hop counts and /0 ranges are refused at start-up.
# TRUST_PROXY=
