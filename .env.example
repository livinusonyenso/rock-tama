# ROCK-TAMA environment variables (copy to .env.local for local overrides; never commit real values).
# See docs/ECOMMERCE_REQUIREMENTS.md → "Configuring enquiry delivery".

# Enquiry delivery: "resend" in production. Local development defaults to a file store
# (.data/enquiries.jsonl) when this is unset. On Vercel delivery requires Resend;
# incomplete deployments automatically stage with noindex until configured.
ENQUIRY_DELIVERY=resend

# Resend API key (https://resend.com → API Keys). Secret: set it in Vercel project settings only.
RESEND_API_KEY=

# Who receives enquiries: one or more addresses, comma-separated.
ENQUIRY_TO=

# Sender, on a domain verified in Resend, e.g. "ROCK-TAMA Enquiries <enquiries@your-domain.com>".
ENQUIRY_FROM=

# Optional: max enquiries per client per 10 minutes (default 5).
# ENQUIRY_RATE_LIMIT=5

# Deployment mode: incomplete deployments default to staging behaviour (warnings + noindex).
# Once delivery and claims are ready, automatic mode permits the public launch.
# DEPLOY_MODE=staging  # explicitly stage
# DEPLOY_MODE=production  # strict launch: require delivery configuration and verified claims
