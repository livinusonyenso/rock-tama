# ROCK-TAMA environment variables (copy to .env.local for local overrides; never commit real values).
# See docs/ECOMMERCE_REQUIREMENTS.md → "Configuring enquiry delivery".

# Enquiry delivery: "resend" in production. Local development defaults to a file store
# (.data/enquiries.jsonl) when this is unset. On Vercel delivery requires Resend;
# incomplete deployments automatically stage with noindex until configured.
ENQUIRY_DELIVERY=resend

# Resend API key (https://resend.com → API Keys). Secret: set it in Vercel project settings only.
RESEND_API_KEY=

# Who receives enquiries: one or more addresses, comma-separated.
ENQUIRY_TO=

# Sender, on a domain verified in Resend, e.g. "ROCK-TAMA Enquiries <enquiries@your-domain.com>".
ENQUIRY_FROM=

# Optional: max enquiries per client per 10 minutes (default 5).
# ENQUIRY_RATE_LIMIT=5

# Deployment mode: incomplete deployments default to staging behaviour (warnings + noindex).
# Once delivery and claims are ready, automatic mode permits the public launch.
# DEPLOY_MODE=staging  # explicitly stage
# DEPLOY_MODE=production  # strict launch: require delivery configuration and verified claims

# ── Online payments: Paystack (D-122) ─────────────────────────────────────────────────────────────
# Without PAYSTACK_SECRET_KEY, checkout uses a built-in TEST gateway ("no money is charged") on development
# and staging; a strict public launch (DEPLOY_MODE=production) refuses to build without a live key.
# Paystack dashboard → Settings → API Keys & Webhooks:
#   sk_test_… = Paystack test mode (test cards, no real money)   sk_live_… = real payments
# PAYSTACK_SECRET_KEY=
# Also set the webhook URL in Paystack to: https://<your-domain>/api/payments/paystack/webhook
# Public site address used for Paystack's return URL (recommended in production), e.g. https://rocktama.com
# SITE_URL=
# Optional: signing secret for the test gateway's tokens (any random string).
# PAYMENT_TEST_SECRET=
# Signing secret for the pending-order cookie on the payment page (D-124). Any long random string;
# falls back to PAYSTACK_SECRET_KEY when unset.
# PAYMENT_TOKEN_SECRET=

# ── Admin portal (D-128) ──────────────────────────────────────────────────────────────────────────
# Sign in at /auth/admin. Real credentials need all three; ADMIN_SESSION_SECRET must be 32+ characters and
# never falls back to payment keys. A strict public launch (DEPLOY_MODE=production) refuses to build without them.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=          # long and unique
# ADMIN_SESSION_SECRET=    # openssl rand -hex 32; signs the admin session cookie
#
# Demo sign-ins (D-133): the distributor demo session and the admin demo login shown on the sign-in page.
# On by default only under `next dev`. A production server (`next start`, Vercel staging, Docker, AWS) needs
# DEMO_AUTH=enabled to show them. Never available with DEPLOY_MODE=production (the build fails if both are set).
# DEMO_AUTH=enabled
